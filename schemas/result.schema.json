{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-venti.local/schemas/result.schema.json",
  "title": "Venti item result",
  "type": "object",
  "required": ["run_id", "plan_id", "item_id", "attempt", "status", "checks", "evidence", "elapsed_ms"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string"},
    "plan_id": {"type": "string"},
    "plan_hash": {"type": "string"},
    "item_id": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["pass", "pass_needs_review", "fail", "flaky", "blocked", "needs_human", "skipped", "error"]},
    "failure_class": {"enum": ["locator", "timing", "environment", "product", "ambiguous", "safety", null]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expectation", "ok", "evidence"],
        "additionalProperties": false,
        "properties": {"expectation": {"type": "string"}, "ok": {"type": "boolean"}, "observed": {}, "evidence": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string"}}
      }
    },
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "healed": {"type": "boolean"},
    "audited": {"type": "boolean"},
    "rubric_pending": {"type": "boolean", "description": "needs_human solely because a declared rubric awaits the verifier agent; not a failure signal."},
    "confidence": {"enum": ["high", "medium", "low"]},
    "reason": {"type": "string"},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string"}
  }
}
