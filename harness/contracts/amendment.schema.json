{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/amendment.schema.json",
  "title": "HONOLOLO post-review asset amendment log",
  "type": "object",
  "required": ["schema_version", "run_id", "amendments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "amendments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/amendment"}
    }
  },
  "$defs": {
    "amendment": {
      "type": "object",
      "required": ["asset", "at", "reason", "sha256"],
      "additionalProperties": false,
      "properties": {
        "asset": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.png$"},
        "at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "sha256": {"$ref": "#/$defs/sha256"},
        "replaced_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
