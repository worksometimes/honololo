{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/plan.schema.json",
  "title": "HONOLOLO approved plan",
  "type": "object",
  "required": ["schema_version", "run_id", "revision", "approved", "steps", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "approved": {"$ref": "#/$defs/approved"},
    "document": {"$ref": "#/$defs/document"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "$comment": "A standing grant authorises a shape of work in advance, so it can only ever cover steps that carry no risk of an external consequence. Anything above low risk needs the user in front of the proposal.",
      "if": {
        "required": ["approved"],
        "properties": {
          "approved": {
            "type": "object",
            "required": ["mode"],
            "properties": {"mode": {"const": "standing"}}
          }
        }
      },
      "then": {
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["risk"],
              "properties": {"risk": {"const": "low"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["steps"],
        "properties": {
          "steps": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["done_when"],
              "properties": {
                "done_when": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {"type": {"const": "rubric"}}
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["fresh_evaluator"],
            "properties": {"fresh_evaluator": {"const": true}}
          }
        }
      }
    }
  ],
  "$defs": {
    "approved": {
      "type": "object",
      "required": ["by", "at", "proposal_sha256"],
      "additionalProperties": false,
      "properties": {
        "by": {"const": "user"},
        "at": {"type": "string", "format": "date-time"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"enum": ["interactive", "standing"]},
        "grant": {"$ref": "#/$defs/id"}
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": {"mode": {"const": "standing"}}
          },
          "then": {"required": ["grant"], "properties": {"grant": true}}
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "goal", "risk", "evidence", "done_when"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "goal": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "approval_gate": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["url", "snapshot", "screenshot", "actions"]}},
        "done_when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/doneWhen"}},
        "manual": {"$ref": "#/$defs/manual"}
      },
      "allOf": [
        {
          "if": {
            "required": ["risk"],
            "properties": {"risk": {"enum": ["high", "critical"]}}
          },
          "then": {
            "required": ["approval_gate"],
            "properties": {"approval_gate": true}
          }
        }
      ]
    },
    "doneWhen": {
      "oneOf": [
        {"$ref": "#/$defs/valueCriterion"},
        {"$ref": "#/$defs/semanticCriterion"}
      ]
    },
    "valueCriterion": {
      "type": "object",
      "required": ["id", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["url_matches", "snapshot_contains", "snapshot_not_contains", "file_exists", "image_exists"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "semanticCriterion": {
      "type": "object",
      "required": ["id", "type", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "rubric"},
        "criterion": {"type": "string", "minLength": 1}
      }
    },
    "manual": {
      "$comment": "What this step becomes in the delivered document. A reader needs more than one imperative sentence: where the step sits, what the screen is for, which controls to press in order, what to look at once it is open, and what would go wrong.",
      "type": "object",
      "required": ["title", "expected", "cautions"],
      "additionalProperties": false,
      "anyOf": [
        {"required": ["instruction"], "properties": {"instruction": true}},
        {"required": ["actions"], "properties": {"actions": true}}
      ],
      "properties": {
        "section": {"type": "string", "minLength": 1, "maxLength": 80},
        "title": {"type": "string", "minLength": 1},
        "intro": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected": {"type": "string", "minLength": 1},
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "detail"],
            "additionalProperties": false,
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 80},
              "detail": {"type": "string", "minLength": 1}
            }
          }
        },
        "example": {
          "type": "object",
          "required": ["ask", "result"],
          "additionalProperties": false,
          "properties": {
            "ask": {"type": "string", "minLength": 1},
            "result": {"type": "string", "minLength": 1}
          }
        },
        "tips": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cautions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "document": {
      "$comment": "Front matter for a manual: what the feature is and why a reader would want it, before any step tells them to press anything.",
      "type": "object",
      "required": ["title", "overview"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "overview": {"type": "string", "minLength": 1},
        "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "review": {
      "type": "object",
      "required": ["fresh_evaluator", "criteria"],
      "additionalProperties": false,
      "properties": {
        "fresh_evaluator": {"type": "boolean"},
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/reviewCriterion"}}
      }
    },
    "reviewCriterion": {
      "type": "object",
      "required": ["id", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "criterion": {"type": "string", "minLength": 1}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
