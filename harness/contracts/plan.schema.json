{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/plan.schema.json",
  "title": "HONOLOLO approved plan",
  "type": "object",
  "required": ["schema_version", "run_id", "revision", "approved", "steps", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "revision": {"type": "integer", "minimum": 1},
    "approved": {"$ref": "#/$defs/approved"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "review": {"$ref": "#/$defs/review"}
  },
  "allOf": [
    {
      "if": {
        "required": ["steps"],
        "properties": {
          "steps": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["done_when"],
              "properties": {
                "done_when": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": ["type"],
                    "properties": {"type": {"const": "rubric"}}
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "type": "object",
            "required": ["fresh_evaluator"],
            "properties": {"fresh_evaluator": {"const": true}}
          }
        }
      }
    }
  ],
  "$defs": {
    "approved": {
      "type": "object",
      "required": ["by", "at", "proposal_sha256"],
      "additionalProperties": false,
      "properties": {
        "by": {"const": "user"},
        "at": {"type": "string", "format": "date-time"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "goal", "risk", "evidence", "done_when"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "goal": {"type": "string", "minLength": 1},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "approval_gate": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["url", "snapshot", "screenshot", "actions"]}},
        "done_when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/doneWhen"}},
        "manual": {"$ref": "#/$defs/manual"}
      },
      "allOf": [
        {
          "if": {
            "required": ["risk"],
            "properties": {"risk": {"enum": ["high", "critical"]}}
          },
          "then": {
            "required": ["approval_gate"],
            "properties": {"approval_gate": true}
          }
        }
      ]
    },
    "doneWhen": {
      "oneOf": [
        {"$ref": "#/$defs/valueCriterion"},
        {"$ref": "#/$defs/semanticCriterion"}
      ]
    },
    "valueCriterion": {
      "type": "object",
      "required": ["id", "type", "value"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["url_matches", "snapshot_contains", "snapshot_not_contains", "file_exists", "image_exists"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "semanticCriterion": {
      "type": "object",
      "required": ["id", "type", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"const": "rubric"},
        "criterion": {"type": "string", "minLength": 1}
      }
    },
    "manual": {
      "type": "object",
      "required": ["title", "instruction", "expected", "cautions"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "cautions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "review": {
      "type": "object",
      "required": ["fresh_evaluator", "criteria"],
      "additionalProperties": false,
      "properties": {
        "fresh_evaluator": {"type": "boolean"},
        "criteria": {"type": "array", "items": {"$ref": "#/$defs/reviewCriterion"}}
      }
    },
    "reviewCriterion": {
      "type": "object",
      "required": ["id", "criterion"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "criterion": {"type": "string", "minLength": 1}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
