{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/annotate.schema.json",
  "title": "HONOLOLO screenshot annotation spec",
  "type": "object",
  "required": ["schema_version", "annotations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "annotation": {
      "oneOf": [
        {"$ref": "#/$defs/box"},
        {"$ref": "#/$defs/badge"},
        {"$ref": "#/$defs/label"},
        {"$ref": "#/$defs/cover"},
        {"$ref": "#/$defs/blur"},
        {"$ref": "#/$defs/arrow"}
      ]
    },
    "box": {
      "type": "object",
      "required": ["type", "rect"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "box"},
        "rect": {"$ref": "#/$defs/rect"},
        "label": {"$ref": "#/$defs/text"},
        "badge": {"$ref": "#/$defs/number"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "badge": {
      "type": "object",
      "required": ["type", "at", "number"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "badge"},
        "at": {"$ref": "#/$defs/point"},
        "number": {"$ref": "#/$defs/number"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "label": {
      "type": "object",
      "required": ["type", "at", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "label"},
        "at": {"$ref": "#/$defs/point"},
        "text": {"$ref": "#/$defs/text"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "cover": {
      "type": "object",
      "required": ["type", "rect"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cover"},
        "rect": {"$ref": "#/$defs/rect"}
      }
    },
    "blur": {
      "type": "object",
      "required": ["type", "rect"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "blur"},
        "rect": {"$ref": "#/$defs/rect"},
        "sigma": {"type": "number", "minimum": 4, "maximum": 40}
      }
    },
    "arrow": {
      "type": "object",
      "required": ["type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "arrow"},
        "from": {"$ref": "#/$defs/point"},
        "to": {"$ref": "#/$defs/point"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false
    },
    "text": {"type": "string", "minLength": 1, "maxLength": 80},
    "number": {"type": "integer", "minimum": 1, "maximum": 99},
    "color": {"enum": ["blue", "red", "gray"]}
  }
}
