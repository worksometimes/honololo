{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/annotate.schema.json",
  "title": "HONOLOLO screenshot annotation spec",
  "type": "object",
  "required": ["schema_version", "annotations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "coordinate_space": {"enum": ["image", "source"]},
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "annotation": {
      "oneOf": [
        {"$ref": "#/$defs/box"},
        {"$ref": "#/$defs/badge"},
        {"$ref": "#/$defs/label"},
        {"$ref": "#/$defs/cover"},
        {"$ref": "#/$defs/blur"},
        {"$ref": "#/$defs/arrow"}
      ]
    },
    "box": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "box"},
        "rect": {"$ref": "#/$defs/rect"},
        "ref": {"$ref": "#/$defs/ref"},
        "pad": {"$ref": "#/$defs/pad"},
        "label": {"$ref": "#/$defs/text"},
        "labelPosition": {"enum": ["above", "below"]},
        "badge": {"$ref": "#/$defs/number"},
        "color": {"$ref": "#/$defs/color"}
      },
      "allOf": [{"$ref": "#/$defs/rectOrRef"}]
    },
    "badge": {
      "type": "object",
      "required": ["type", "at", "number"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "badge"},
        "at": {"$ref": "#/$defs/point"},
        "number": {"$ref": "#/$defs/number"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "label": {
      "type": "object",
      "required": ["type", "at", "text"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "label"},
        "at": {"$ref": "#/$defs/point"},
        "text": {"$ref": "#/$defs/text"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "cover": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "cover"},
        "rect": {"$ref": "#/$defs/rect"},
        "ref": {"$ref": "#/$defs/ref"},
        "pad": {"$ref": "#/$defs/pad"}
      },
      "allOf": [{"$ref": "#/$defs/rectOrRef"}]
    },
    "blur": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "blur"},
        "rect": {"$ref": "#/$defs/rect"},
        "ref": {"$ref": "#/$defs/ref"},
        "pad": {"$ref": "#/$defs/pad"},
        "sigma": {"type": "number", "minimum": 4, "maximum": 40}
      },
      "allOf": [{"$ref": "#/$defs/rectOrRef"}]
    },
    "arrow": {
      "type": "object",
      "required": ["type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "arrow"},
        "from": {"$ref": "#/$defs/point"},
        "to": {"$ref": "#/$defs/point"},
        "color": {"$ref": "#/$defs/color"}
      }
    },
    "rectOrRef": {
      "type": "object",
      "oneOf": [
        {"type": "object", "required": ["rect"], "properties": {"rect": true, "ref": false}},
        {"type": "object", "required": ["ref"], "properties": {"ref": true, "rect": false}}
      ]
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "items": false
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false
    },
    "ref": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
    "pad": {"type": "integer", "minimum": 0, "maximum": 64},
    "text": {"type": "string", "minLength": 1, "maxLength": 80},
    "number": {"type": "integer", "minimum": 1, "maximum": 99},
    "color": {"enum": ["blue", "red", "gray"]}
  }
}
