{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honololo.local/contracts/run.schema.json",
  "title": "HONOLOLO run request",
  "type": "object",
  "required": ["schema_version", "id", "type", "target", "goal", "deliverables", "completion", "forbidden", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "type": {"enum": ["qa", "manual"]},
    "target": {"$ref": "#/$defs/target"},
    "goal": {"type": "string", "minLength": 1},
    "deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outputPath"}},
    "completion": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z_]*$"}},
    "limits": {"$ref": "#/$defs/limits"}
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["url", "allowed_domains"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@\\s]+(?::[0-9]+)?(?:/[^?#\\s]*)?(?:\\?[^#\\s]*)?$"
        },
        "allowed_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"}
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "outputPath": {"type": "string", "pattern": "^output/(?:[a-zA-Z0-9][a-zA-Z0-9._-]*/)*[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
    "limits": {
      "type": "object",
      "required": ["max_actions"],
      "additionalProperties": false,
      "properties": {
        "max_actions": {"type": "integer", "minimum": 1}
      }
    }
  }
}
